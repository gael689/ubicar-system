# URL del backend, SIN el sufijo /api/v1 — el cliente de src/lib/api.ts ya lo
# agrega. En produccion: https://api.ubicar-rent.com.ar
VITE_API_URL=http://localhost:8000

# Auth: el proyecto usa Clerk (ver docs/AUTH_CLERK.md), no Auth0. Estas
# variables se completan cuando se integre; hasta entonces el backend corre
# con DEV_BYPASS_AUTH y no se validan tokens.
VITE_CLERK_PUBLISHABLE_KEY=
