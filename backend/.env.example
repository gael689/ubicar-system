# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ubicar_rent
# Poner en true SOLO en serverless: alli cada instancia abre su propio pool.
DB_SIN_POOL=false

# Auth (Clerk)
# DEV_BYPASS_AUTH=true hace que get_current_user devuelva un admin sin validar
# token. Poner en false el dia que Clerk este integrado.
DEV_BYPASS_AUTH=true
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
# auth_sub de los admins iniciales, separados por coma
CLERK_ADMIN_SUBS=

# Storage (Cloudflare R2 / S3)
# "local" en desarrollo. En serverless el disco es efimero: alli va "r2".
STORAGE_PROVIDER=local
STORAGE_PATH=./storage_local
STORAGE_BUCKET=ubicar-rent-docs
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Dominio publico del bucket. Sin esto, public_url firma URLs que caducan.
STORAGE_PUBLIC_BASE_URL=

# Email (Resend)
# Vacio = no sale ningun mail; el intento queda registrado como fallido en la
# tabla `emails_enviados` y se puede reintentar desde el panel.
RESEND_API_KEY=
# OJO: mientras esto termine en @resend.dev (el remitente compartido de prueba
# de Resend, que SOLO entrega a la casilla duena de la cuenta) los mails a
# clientes no se mandan: quedan registrados como "omitido" con el motivo, para
# no reportar como enviado algo que no va a llegar. Con el dominio verificado
# en Resend, cambiar este valor es lo unico que hay que hacer.
FROM_EMAIL=noreply@ubicarrent.com
# Digest matutino (08:00 ART): a quien se le manda, separado por coma.
# Tambien es el respaldo de los avisos internos si la clave de configuracion
# `web.emails_aviso_reserva` esta vacia.
NOTIFICACIONES_DIGEST_DESTINATARIOS=

# Pagos online (Mercado Pago)
# "fake" usa una pasarela en memoria para recorrer el flujo en desarrollo.
# En ENVIRONMENT=production la factory se niega a devolverla: una pasarela
# simulada confirmaria reservas sin cobrar.
PAGOS_PROVIDER=fake
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta del webhook (panel de MP > Webhooks). Distinta por ambiente.
# Vacia: no se valida la firma y el webhook sigue funcionando igual.
MERCADOPAGO_WEBHOOK_SECRET=
# true mientras se usen credenciales de prueba (abre sandbox_init_point).
MERCADOPAGO_SANDBOX=true
# URL publica del backend: Mercado Pago tiene que poder alcanzar el webhook
# desde afuera, asi que en local esto va con un tunel (ngrok), no localhost.
BACKEND_PUBLIC_URL=

# Cron externo (solo en serverless, donde el scheduler del proceso no existe).
# Vacio = el endpoint de cron queda deshabilitado.
CRON_SECRET=

# App
FRONTEND_URL=http://localhost:5173
# La web publica (Next.js): a donde vuelve el cliente despues de pagar.
WEB_URL=http://localhost:3200
ENVIRONMENT=development
