# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ubicar_rent

# Auth0
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN.auth0.com
AUTH0_AUDIENCE=https://api.ubicarrent.com
AUTH0_CLIENT_ID=YOUR_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_AUTH0_CLIENT_SECRET

# Storage (Cloudflare R2)
STORAGE_BUCKET=ubicar-rent-docs
STORAGE_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
STORAGE_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Email (Resend)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
FROM_EMAIL=noreply@ubicarrent.com
# Digest matutino de notificaciones (08:00 ART): a quién se le manda, separado por coma. Vacío = no se envía nada.
NOTIFICACIONES_DIGEST_DESTINATARIOS=franco@ubicarrent.com,martin@ubicarrent.com

# App
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development
