# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos la plantilla, que existe justamente para versionarse: es donde se
# documenta qué variables hacen falta para levantar la web. La regla `.env*` la
# venía tapando, así que los cambios en `.env.example` nunca llegaban al repo y
# quien clonaba no se enteraba de las variables nuevas. No lleva secretos: los
# valores reales van en `.env.local`, que sigue ignorado.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
