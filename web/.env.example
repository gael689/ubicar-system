# Variables de la web publica. Copiar a `.env.local` para desarrollo, y
# cargarlas en Vercel para produccion.

# ── Backend ───────────────────────────────────────────────────────────────────
# CON `/api/v1` incluido y SIN barra final. El sistema interno (`frontend/`) usa
# la MISMA URL pero SIN el `/api/v1`, porque su cliente lo agrega solo: ponerlo
# en los dos termina pidiendo `/api/v1/api/v1` y todo da 404.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Bucket de archivos (Cloudflare R2) ────────────────────────────────────────
# Dominio publico del bucket, de donde salen las fotos de las categorias.
#
# ⚠️ OBLIGATORIA EN PRODUCCION. `next/image` necesita el host declarado **en
# tiempo de build** (`next.config.ts`): sin ella el deploy sale en verde y las
# fotos de las categorias NO renderizan, aunque las URLs que devuelve la API
# sean correctas. Tiene que coincidir con `STORAGE_PUBLIC_BASE_URL` del backend.
NEXT_PUBLIC_STORAGE_URL=https://pub-dc0a8f08881c4db095f52a836c074c3e.r2.dev

# ── Meta / analitica ──────────────────────────────────────────────────────────
# Las tres primeras NO son secretas: viajan en el HTML de todas formas. Estan
# como variables para poder apuntar a una propiedad de prueba y verificar el
# embudo sin ensuciar los numeros reales. Si faltan, el codigo usa los IDs de
# produccion como valor por defecto.
#
# El ID del pixel va DOS veces y con dos nombres, y no es un error: el que
# empieza con NEXT_PUBLIC_ lo lee el navegador para inicializar el pixel, y el
# otro lo lee la ruta /api/track del servidor. Next solo expone al cliente las
# variables con ese prefijo. Tienen que tener el mismo valor.
NEXT_PUBLIC_META_PIXEL_ID=26876823408666329
META_PIXEL_ID=26876823408666329

# Propiedad de Google Analytics 4 (formato G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=G-25783YNP7G

# ⚠️ ROTAR ANTES DE PUBLICAR. En la version Vite este token vivia dentro del
# bundle de JavaScript, o sea que fue publico. Ya se movio al servidor, pero el
# viejo sigue comprometido: generar uno nuevo en Meta Business y usar ese.
#
# Mientras este vacia, /api/track responde ok:false y NO manda nada: los eventos
# solo llegan a Meta por el pixel del navegador. O sea que hoy la mitad
# server-side del tracking esta apagada, y con ella la recuperacion de lo que
# bloquean los bloqueadores de anuncios y Safari.
META_CONVERSIONS_TOKEN=
